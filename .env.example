# Copy to .env and fill in. Never commit .env.
# --- PostgreSQL bootstrap superuser (initialization/migrations only; never used by the API) ---
POSTGRES_USER=t2s_admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=t2s
# --- Least-privilege runtime roles (created by db/init/03_roles.sh) ---
T2S_APP_PASSWORD=change-me-app          # app_meta history/audit/feedback writer
T2S_READER_PASSWORD=change-me-reader    # SELECT-only, read-only query role
# --- API connection (inside Compose DB_HOST=db, DB_PORT=5432) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=t2s
READER_PASSWORD=change-me-reader
APP_PASSWORD=change-me-app
# --- LLM provider: mock | anthropic | openai ---
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# --- Guardrails ---
MAX_RESULT_ROWS=1000
STATEMENT_TIMEOUT_MS=5000
MAX_SUBQUERY_DEPTH=3
MAX_JOINS=6
MAX_PLAN_TOTAL_COST=50000
MAX_PLAN_ROWS_SCANNED=200000
MAX_REPAIR_ATTEMPTS=1
# --- Confidence decision thresholds ---
CONFIDENCE_ANSWER_THRESHOLD=0.70
CONFIDENCE_ABSTAIN_THRESHOLD=0.40
# --- Privacy / API ---
HISTORY_PREVIEW_ROWS=20
API_TOKEN=                               # optional bearer token for /v1/*
