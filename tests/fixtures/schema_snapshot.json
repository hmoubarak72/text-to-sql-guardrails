 "glossary": [
  {
   "term": "gross revenue",
   "definition": "SUM(order_items.quantity * order_items.unit_price * (1 - order_items.discount)) over non-cancelled orders.",
   "tables": [
    "order_items",
    "orders"
   ]
  },
  {
   "term": "net revenue",
   "definition": "Gross revenue minus SUM(refunds.amount) for the same orders.",
   "tables": [
    "order_items",
    "orders",
    "refunds"
   ]
  },
  {
   "term": "sales",
   "definition": "Synonym of gross revenue unless stated otherwise.",
   "tables": [
    "order_items",
    "orders"
   ]
  },
  {
   "term": "units sold",
   "definition": "SUM(order_items.quantity) over non-cancelled orders.",
   "tables": [
    "order_items",
    "orders"
   ]
  },
  {
   "term": "average order value",
   "definition": "Average of payments.amount per paid order.",
   "tables": [
    "payments"
   ]
  },
  {
   "term": "margin",
   "definition": "SUM(quantity * (unit_price * (1 - discount) - products.unit_cost)).",
   "tables": [
    "order_items",
    "products"
   ]
  },
  {
   "term": "active product",
   "definition": "products.is_active = TRUE.",
   "tables": [
    "products"
   ]
  },
  {
   "term": "refund rate",
   "definition": "COUNT(DISTINCT refunds.order_id) / COUNT(DISTINCT orders.order_id) over non-cancelled orders.",
   "tables": [
    "orders",
    "refunds"
   ]
  }
 ],
